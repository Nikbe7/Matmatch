{
  "name": "matmatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --prefix web",
    "test": "vitest run",
    "validate": "tsx src/tools/validate.ts",
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "start": "tsx --env-file=.env src/api/server.ts",
    "start:cloud": "tsx --env-file=.env.cloud src/api/server.ts",
    "start:prod": "tsx src/api/server.ts",
    "build": "npm run build --prefix web",
    "deploy": "fly deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "express": "^5.2.1",
    "jose": "^6.2.7",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supabase": "^2.111.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
