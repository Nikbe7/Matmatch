# Copy to .env and fill in. Never commit .env — it is gitignored.
# Both values are public by design: Supabase's anon key is meant to ship in a
# browser bundle, and the URL/key pair alone cannot reach the database — this
# project's Data API is disabled (see ARCHITECTURE.md §2). See README.md.

# Local (from `npx supabase status`, run at the repo root):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Cloud: https://<project-ref>.supabase.co and the anon key from
# Project Settings → API.

# ImageKit public key and URL endpoint, from the dashboard (Developer Options →
# API Keys). Both are safe to ship client-side — they identify the account for
# upload auth but cannot authorize an upload without the server-signed token
# (see IMAGEKIT_PRIVATE_KEY in the root .env.example).
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
