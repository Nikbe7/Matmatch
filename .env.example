# Copy to .env and fill in. Never commit .env — it is gitignored.
# See README.md for where each value comes from.

# --- Database -----------------------------------------------------------------
# The backend connects as `matmatch_app`: a least-privilege role with no RLS bypass,
# so row-level security actually constrains its queries (issue #53). Never point this
# at `postgres`, `supabase_admin`, or a service-role connection — those carry
# rolbypassrls, which silently turns household scoping off.
#
# Local (password is set by supabase/seed.sql on `supabase db reset`):
DATABASE_URL=postgresql://matmatch_app:matmatch_local_dev@127.0.0.1:54322/postgres
#
# Cloud: same role, a password you set once in the dashboard SQL editor (see README).
# Host and port come from Project Settings → Database; use the *session* pooler for a
# long-lived Node backend.

# --- Auth (JWT verification) --------------------------------------------------
# The backend only ever verifies tokens; it never mints them, so no signing key or
# service-role key belongs in this file.
# Local:
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Cloud: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional. Leave unset to skip the check; set to pin tokens to one issuer.
# Local: http://127.0.0.1:54321/auth/v1
# Cloud: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# Supabase issues `authenticated` as the audience for signed-in users.
SUPABASE_JWT_AUDIENCE=authenticated
